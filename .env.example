# Copy to `.env` in the repo root and fill in your values. Never commit `.env` (it is gitignored).
# One file serves everything: the API (`pnpm dev:api`), the web app and docker compose.
# Don't add an `apps/backend/.env`: the API also reads it, and its values silently override this
# file's, so a setting changed here would seem to have no effect.

# ---- Backend (apps/backend) — all prefixed PROMETEO_ ---------------------------------------
PROMETEO_ENV=dev
# Curated trial files, comma-separated, relative to data/. For UI work without curated data:
#   PROMETEO_TRIAL_FILES=fixtures/synthetic_trials.json  and  PROMETEO_INCLUDE_SYNTHETIC=true
# Synthetic fixtures are invented values and are labelled as such everywhere in the UI.
PROMETEO_TRIAL_FILES=curated/trials.json
PROMETEO_INCLUDE_SYNTHETIC=false
PROMETEO_DOCUMENT_CHUNKS_FILE=curated/document_chunks.json

# json (MVP) | postgres (not wired yet)
PROMETEO_TRIAL_STORE=json
PROMETEO_DATABASE_URL=postgresql://prometeo:prometeo@localhost:5432/prometeo

# Research Assistant documents: json (keyword search over PROMETEO_DOCUMENT_CHUNKS_FILE) |
# postgres (hybrid full-text + pgvector search over the knowledge base).
# For postgres: install the Python env with `uv sync --extra knowledge` (a bare `uv sync` removes
# the embedding model and the assistant then fails), then `pnpm db:up` and `pnpm kb:build`.
# kb:build also downloads the source PDFs to data/raw/psi, which "Read in the PDF" shows.
PROMETEO_DOCUMENT_STORE=json
PROMETEO_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Who writes the Research Assistant's explanation:
# offline (deterministic template, no API call, no key needed) | anthropic (Claude)
# Either way the numbers come from the Evidence Engine and the output passes the same audit.
PROMETEO_EXPLAINER=offline
# Model that writes the interpretation when a question does not pick one.
PROMETEO_ANTHROPIC_MODEL=claude-sonnet-5-5
# Models offered in the Research Assistant's picker (the default is always included).
PROMETEO_ANTHROPIC_MODELS=claude-sonnet-5-5,claude-opus-5-5,claude-haiku-5-5
PROMETEO_ANTHROPIC_EFFORT=high
# Required only when PROMETEO_EXPLAINER=anthropic (or use an `ant auth login` profile).
# Each teammate uses their own key. Never paste it anywhere else.
ANTHROPIC_API_KEY=

PROMETEO_CORS_ORIGINS=http://localhost:3000

# ---- Frontend (apps/frontend) ---------------------------------------------------------------
PROMETEO_API_URL=http://localhost:8000

# ---- Database (docker compose) --------------------------------------------------------------
POSTGRES_USER=prometeo
POSTGRES_PASSWORD=prometeo
POSTGRES_DB=prometeo
# Host port for the database. Change it if 5432 is taken, and change PROMETEO_DATABASE_URL to match.
POSTGRES_PORT=5432
